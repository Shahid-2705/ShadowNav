# Raw dataset — fetched by `python -m shadownav.data.fetch`, never committed.
# IO-VNBD is CC BY 4.0 via its Data in Brief version; we redistribute nothing.
/data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# Generated evaluation artifacts (numbers live in eval/results/*.json, which IS committed)
/eval/results/**/*.png
/eval/results/**/*.npz

# Android
/android/**/build/
/android/.gradle/
/android/.kotlin/
/android/local.properties

# Editors / OS / agent tooling
.DS_Store
.idea/
.vscode/

# Claude Code local configuration: settings, agents, skills, session state.
# Machine-specific and often carries local paths, so it does not belong in the
# repo. Note this is the .claude/ DIRECTORY only -- CLAUDE.md at the repo root
# is a deliberate, checked-in project document and stays tracked.
.claude/
