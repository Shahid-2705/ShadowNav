<?xml version="1.0" encoding="utf-8"?>
<!-- ShadowNav mark.

     The name refers to GPS shadow, the standard term for a zone where the
     satellite signal is blocked, so the mark is a heading arrow passing through
     one. It reads as a single silhouette at launcher size: a navigation chevron
     rising out of an arc, with the arc broken on the shadowed side.

     Colour carries meaning rather than decoration, and it is the same language
     the running app and the presentation demo use:
       cyan     GNSS aided
       magenta  dead reckoning
       amber    the calibrated confidence ring

     Adaptive icon geometry: 108x108 viewport, but only the central 66x66 is
     guaranteed visible on every launcher mask, so the artwork stays inside
     roughly 24..84 and the important part inside 34..74.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Confidence ring, lit arc: the part of the sky still in view. -->
    <path
        android:strokeColor="#4DE0E8"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M30,66 A24,24 0 0,1 54,42" />

    <!-- Confidence ring, shadowed arc: dimmer and magenta, and deliberately
         not closed. The gap is the blackout. -->
    <path
        android:strokeColor="#E24DBE"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,42 A24,24 0 0,1 78,66" />

    <!-- Uncertainty growing under the shadowed side: three ticks that fade,
         which is what the app's ring actually does during an outage. -->
    <path
        android:strokeColor="#E24DBE"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeAlpha="0.75"
        android:fillColor="#00000000"
        android:pathData="M72,74 L76,80" />
    <path
        android:strokeColor="#E24DBE"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeAlpha="0.45"
        android:fillColor="#00000000"
        android:pathData="M62,79 L64,86" />
    <path
        android:strokeColor="#E24DBE"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeAlpha="0.22"
        android:fillColor="#00000000"
        android:pathData="M50,81 L50,88" />

    <!-- The heading chevron, carrying straight through the gap. This is the
         whole idea of the product in one shape: the estimate does not stop
         where the signal does. -->
    <path
        android:fillColor="#4DE0E8"
        android:pathData="M54,26 L70,68 L54,59 L38,68 Z" />
</vector>
