<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ACCESS_FINE_LOCATION is the only location permission this app's own
         code needs. Raw GnssMeasurement and per-constellation status require
         no Developer Options toggle. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- MapLibre Native's own manifest unconditionally declares INTERNET,
         ACCESS_NETWORK_STATE, ACCESS_WIFI_STATE and ACCESS_COARSE_LOCATION,
         for its optional network tile-fetching and built-in "my location"
         layer, neither of which this app uses (blueprint Step 3: the route
         scene loads only a bundled `mbtiles:///android_asset/...` source,
         never a network style URL, and the vehicle position comes from this
         app's own estimator, never MapLibre's location layer). Stripping
         them keeps the shipped permission set honest to what the app
         actually does, and preserves the "on-device, no cloud" pitch
         (PLAN.md §3.8) that a bundled-but-still-network-permitted map would
         otherwise quietly contradict. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />

    <!-- Required since Android 12 (API 31) to request sensor rates above
         200 Hz. SENSOR_DELAY_FASTEST is 0 microseconds, which counts as
         "above 200 Hz", and without this the registration throws a
         SecurityException rather than degrading. It crashed on a moto g64
         running Android 15 before this was declared.

         It is a "normal" permission: granted at install, no runtime prompt.
         Sample rate is the variable every result in this project depends on,
         so asking for the maximum is not gold-plating. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <!-- A foreground service is the only reliable way to keep sensor and
         location callbacks alive on modern Android. Without it the first
         hardware test stopped collecting two minutes in, the moment the user
         switched apps. For something whose purpose is surviving a tunnel,
         losing state because the screen turned off is a defect. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Needed for the service to keep receiving fixes while backgrounded.
         Requested separately and only after foreground location is granted,
         which is what Android requires. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Declared but not required: the app must run on a device with no
         gyroscope-quality guarantee, and it degrades rather than refusing. -->
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.sensor.gyroscope"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="ShadowNav"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShadowNav">

        <!-- Shares a recorded trip CSV, and nothing else: the path config
             exposes only the trips directory in app-private storage. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.trips"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".NavigationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:keepScreenOn="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
